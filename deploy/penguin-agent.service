# penguin-agent runs inside every Penguin LXC, supervising the game process and
# exposing console/logs/exit/stats to Wings. Installed into the base template.
[Unit]
Description=Penguin Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/penguin-agent/agent.env
ExecStart=/usr/local/bin/penguin-agent --addr :8443
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
